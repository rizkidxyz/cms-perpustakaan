# ========================================
# APPLICATION
# ========================================

APP_URL="http://localhost:3000"

# ========================================
# DATABASE
# DB_PROVIDER: mysql | postgresql (alias pg/postgres) | neon
#
# Isi salah satu saja:
#   1. DB_URL  -> connection string lengkap
#   2. DB_HOST, DB_NAME, DB_USER (+ DB_PASSWORD, DB_PORT, DB_SSLMODE)
#
# DB_URL_DIRECT opsional. Dipakai Prisma CLI untuk migrate/introspect.
# Di Neon, isi dengan endpoint tanpa "-pooler", atau biarkan kosong
# supaya -pooler dilepas otomatis dari DB_URL.
# ========================================

DB_PROVIDER="postgresql"

DB_URL=""
DB_URL_DIRECT=""

DB_HOST=""
DB_PORT=""
DB_NAME=""
DB_USER=""
DB_PASSWORD=""
DB_SSLMODE="require"

# ========================================
# AUTHENTICATION
# ========================================

AUTH_SECRET=""

# ========================================
# INITIAL ADMIN ACCOUNT
# ========================================

ADMIN_NAME="Administrator"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
