// Merge this schema into prisma/schema.prisma.
// It preserves the existing User / Session / LoginAttempt authentication tables
// and adds dynamic categories and CMS posts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  EDITOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum PostVisibility {
  PUBLIC
  UNLISTED
}

model User {
  id           String   @id @default(cuid()) @db.VarChar(191)
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  posts    Post[]
}

model Session {
  id        String   @id @default(cuid()) @db.VarChar(191)
  tokenHash String   @unique @db.Char(64)
  userId    String   @db.VarChar(191)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid()) @db.VarChar(191)
  keyHash   String   @db.Char(64)
  createdAt DateTime @default(now())

  @@index([keyHash, createdAt])
  @@index([createdAt])
}

model Category {
  id          String   @id @default(cuid()) @db.VarChar(191)
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]

  @@index([isActive, name])
}

model Post {
  id          String         @id @default(cuid()) @db.VarChar(191)
  title       String         @db.VarChar(180)
  slug        String         @unique @db.VarChar(160)
  excerpt     String?        @db.VarChar(500)
  content     Json
  coverImage  String?        @db.VarChar(2048)
  status      PostStatus     @default(DRAFT)
  visibility  PostVisibility @default(PUBLIC)
  publishedAt DateTime?

  authorId   String  @db.VarChar(191)
  categoryId String? @db.VarChar(191)

  author   User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, visibility, publishedAt])
  @@index([categoryId, status, visibility, publishedAt])
  @@index([authorId, updatedAt])
}
